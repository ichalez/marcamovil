# Copia este archivo a .env.local y rellénalo con la configuración web de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web → Configuración)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo local con los emuladores de Firebase (firebase emulators:start en la raíz)
# VITE_USE_EMULATORS=true
